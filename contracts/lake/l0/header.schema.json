{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "l0/header.schema.json",
  "title": "QRAW1 header",
  "description": "The header JSON of an L0 file (contract document 2.2). Exactly one of three forms.",
  "oneOf": [
    {
      "description": "by_symbol day file and instruments day file",
      "type": "object",
      "properties": {
        "contract_ver": {
          "type": "integer",
          "const": 1
        },
        "form": {
          "const": "topic"
        },
        "venue": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]*$"
        },
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
        },
        "collector": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_]*$",
          "description": "writer process of the first record's stage-1 file; for a sealer session file, the sealer name"
        },
        "collector_ver": {
          "type": "string",
          "minLength": 1
        },
        "host": {
          "type": "string",
          "minLength": 1
        },
        "market": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]*$"
        },
        "channel": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9.-]*$"
        },
        "symbol": {
          "type": "string",
          "pattern": "^([A-Za-z0-9][A-Za-z0-9.-]*|_all)$",
          "description": "_all only in the instruments day file"
        }
      },
      "required": [
        "contract_ver",
        "form",
        "venue",
        "date",
        "collector",
        "collector_ver",
        "host",
        "market",
        "channel",
        "symbol"
      ],
      "additionalProperties": false
    },
    {
      "description": "open file and by_connection day file",
      "type": "object",
      "properties": {
        "contract_ver": {
          "type": "integer",
          "const": 1
        },
        "form": {
          "const": "connection"
        },
        "venue": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]*$"
        },
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
        },
        "collector": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_]*$",
          "description": "writer process of the first record's stage-1 file; for a sealer session file, the sealer name"
        },
        "collector_ver": {
          "type": "string",
          "minLength": 1
        },
        "host": {
          "type": "string",
          "minLength": 1
        },
        "session_ns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "conn_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      },
      "required": [
        "contract_ver",
        "form",
        "venue",
        "date",
        "collector",
        "collector_ver",
        "host",
        "session_ns",
        "conn_id"
      ],
      "additionalProperties": false
    },
    {
      "description": "session file",
      "type": "object",
      "properties": {
        "contract_ver": {
          "type": "integer",
          "const": 1
        },
        "form": {
          "const": "session"
        },
        "venue": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]*$"
        },
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
        },
        "collector": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_]*$",
          "description": "writer process of the first record's stage-1 file; for a sealer session file, the sealer name"
        },
        "collector_ver": {
          "type": "string",
          "minLength": 1
        },
        "host": {
          "type": "string",
          "minLength": 1
        },
        "session_ns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        }
      },
      "required": [
        "contract_ver",
        "form",
        "venue",
        "date",
        "collector",
        "collector_ver",
        "host",
        "session_ns"
      ],
      "additionalProperties": false
    }
  ]
}
