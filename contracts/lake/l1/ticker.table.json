{
  "table": "ticker",
  "contract_ver": 1,
  "description": "One row per ticker message of every connection; a delta row holds only the fields the message carried (contract 3.4).",
  "key": [
    "venue",
    "market",
    "symbol",
    "l0_file_id",
    "rec_no"
  ],
  "sort": [
    {
      "column": "symbol"
    },
    {
      "column": "recv_ns"
    },
    {
      "column": "l0_file_id"
    },
    {
      "column": "rec_no"
    }
  ],
  "path": "crypto/l1/ticker/venue={venue}/market={market}/channel={channel}/date={date}/",
  "file_names": [
    "hour={hour}.parquet",
    "day.parquet"
  ],
  "compression": "zstd",
  "compression_level": 9,
  "size_target_bytes": {
    "min": 100000000,
    "max": 10000000000
  },
  "metadata": [
    "contract_ver",
    "parser_ver",
    "table"
  ],
  "columns": [
    {
      "name": "venue",
      "type": "string",
      "nullable": false
    },
    {
      "name": "market",
      "type": "string",
      "nullable": false
    },
    {
      "name": "symbol",
      "type": "string",
      "nullable": false
    },
    {
      "name": "channel",
      "type": "string",
      "nullable": false
    },
    {
      "name": "kind",
      "type": "int8",
      "nullable": false,
      "description": "0 snapshot, 1 delta"
    },
    {
      "name": "venue_ts_ns",
      "type": "int64",
      "nullable": false,
      "description": "the venue's event time"
    },
    {
      "name": "recv_ns",
      "type": "int64",
      "nullable": false,
      "description": "our receive time"
    },
    {
      "name": "last_px",
      "type": "int64",
      "nullable": true
    },
    {
      "name": "mark_px",
      "type": "int64",
      "nullable": true
    },
    {
      "name": "index_px",
      "type": "int64",
      "nullable": true
    },
    {
      "name": "funding_rate",
      "type": "int64",
      "nullable": true,
      "description": "in units of 1e-8"
    },
    {
      "name": "next_funding_ns",
      "type": "int64",
      "nullable": true
    },
    {
      "name": "open_interest",
      "type": "int64",
      "nullable": true,
      "description": "with qty_exp"
    },
    {
      "name": "best_bid_px",
      "type": "int64",
      "nullable": true
    },
    {
      "name": "best_bid_qty",
      "type": "int64",
      "nullable": true
    },
    {
      "name": "best_ask_px",
      "type": "int64",
      "nullable": true
    },
    {
      "name": "best_ask_qty",
      "type": "int64",
      "nullable": true
    },
    {
      "name": "px_exp",
      "type": "int8",
      "nullable": false,
      "description": "price exponent (1.3)"
    },
    {
      "name": "qty_exp",
      "type": "int8",
      "nullable": false,
      "description": "quantity exponent (1.3)"
    },
    {
      "name": "conn_id",
      "type": "int32",
      "nullable": false,
      "description": "lineage: connection number inside the collector session"
    },
    {
      "name": "frame_no",
      "type": "int64",
      "nullable": false,
      "description": "lineage"
    },
    {
      "name": "l0_file_id",
      "type": "string",
      "nullable": false,
      "description": "lineage"
    },
    {
      "name": "rec_no",
      "type": "int64",
      "nullable": false,
      "description": "lineage"
    },
    {
      "name": "parser_ver",
      "type": "string",
      "nullable": false,
      "description": "lineage"
    }
  ]
}
