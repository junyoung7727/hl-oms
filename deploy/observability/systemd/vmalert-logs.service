# Not installed or enabled by this repository: docs/operations/observability.md.
[Unit]
Description=vmalert for the log rules (VictoriaLogs, every 30 s)
After=victoriametrics.service victorialogs.service alertmanager.service

[Service]
Type=simple
User=hlobs
Group=hlobs
ExecStart=/usr/local/bin/vmalert-prod -rule=/etc/hl-oms-obs/vmalert/logs/*.json -rule.defaultRuleType=vlogs -datasource.url=http://127.0.0.1:9428 -remoteWrite.url=http://127.0.0.1:8428 -remoteRead.url=http://127.0.0.1:8428 -notifier.url=http://127.0.0.1:9093 -evaluationInterval=30s -httpListenAddr=127.0.0.1:8881
Restart=on-failure
RestartSec=5
MemoryMax=200M
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
