# Not installed or enabled by this repository: docs/operations/observability.md.
[Unit]
Description=Grafana: dashboards D2 and D3
After=network-online.target victoriametrics.service victorialogs.service
Wants=network-online.target

[Service]
Type=simple
User=hlobs
Group=hlobs
WorkingDirectory=/opt/grafana
ExecStart=/opt/grafana/bin/grafana server --homepath /opt/grafana --config /etc/hl-oms-obs/grafana/grafana.ini
Restart=on-failure
RestartSec=5
MemoryMax=512M
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/mnt/nvme/observability/grafana

[Install]
WantedBy=multi-user.target
